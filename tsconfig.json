{
    "compilerOptions": {
        "outDir": "bin",
        "sourceMap": true,
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "files": ["index.ts", "guestbook.ts", "monitoring.ts"]
}
